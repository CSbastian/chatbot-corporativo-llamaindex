# ============================================================================
# API KEY REQUERIDA
# ============================================================================

# OpenAI API Key (requerido)
OPENAI_API_KEY=sk-...

# ============================================================================
# CONFIGURACIÓN OPCIONAL
# ============================================================================

# Modelo de OpenAI (opcional - default: gpt-4o)
OPENAI_MODEL=gpt-4o


# Modelo de embeddings (opcional - default: text-embedding-3-small)
EMBEDDING_MODEL=text-embedding-3-small

# ============================================================================
# BASE DE DATOS PARA LOGGING (OPCIONAL)
# ============================================================================

# URL de la base de datos para almacenar logs de chat (opcional - default: SQLite local)
#
# Ejemplos según el tipo de base de datos:
#
#   SQLite (local - default):
#   DATABASE_URL=sqlite:///./logs/chatbot.db
#
#   PostgreSQL:
#   DATABASE_URL=postgresql://user:password@localhost:5432/chatbot_logs
#
#   MySQL:
#   DATABASE_URL=mysql://user:password@localhost:3306/chatbot_logs
#
# NOTA: Si usas PostgreSQL o MySQL, debes instalar los drivers correspondientes:
#   - PostgreSQL: pip install psycopg2-binary
#   - MySQL: pip install pymysql
#
# DATABASE_URL=sqlite:///./logs/chatbot.db
